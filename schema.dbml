Table clients {
  id varchar [pk]
  name varchar [not null]
  email varchar
  phone varchar
  notes varchar
  preferred_contact varchar
  lead_source varchar
  address varchar
  created_at varchar [not null]
  archived varchar
  deleted varchar
}

Table jobs {
  id varchar [pk]
  client_id varchar [not null, ref: > clients.id]
  description varchar [not null]
  status varchar [not null, note: 'draft | in_progress | delivered | paid | cancelled']
  price numeric
  board_order numeric
  created_at varchar [not null]
  archived varchar
  deleted varchar
}

Table pieces {
  id varchar [pk]
  job_id varchar [not null, ref: > jobs.id]
  name varchar [not null]
  status varchar [not null, note: 'pending | done | failed']
  price numeric
  units numeric
  created_at varchar [not null]
  archived varchar
  deleted varchar
}

Table piece_items {
  id varchar [pk]
  piece_id varchar [not null, ref: > pieces.id]
  inventory_id varchar [not null, ref: > inventory.id]
  quantity numeric [not null]
  archived varchar
  deleted varchar
}

Table inventory {
  id varchar [pk]
  type varchar [not null, note: 'filament | consumable | equipment']
  name varchar [not null]
  qty_current numeric [not null]
  warn_yellow numeric [not null]
  warn_orange numeric [not null]
  warn_red numeric [not null]
  created_at varchar [not null]
  archived varchar
  deleted varchar
}

Table lots {
  id varchar [pk]
  inventory_id varchar [not null, ref: > inventory.id]
  transaction_id varchar [not null, ref: > transactions.id]
  quantity numeric [not null]
  amount numeric [not null]
  created_at varchar [not null]
  archived varchar
  deleted varchar
}

Table transactions {
  id varchar [pk]
  date varchar [not null]
  type varchar [not null, note: 'income | expense']
  amount numeric [not null]
  category varchar [not null, note: 'filament | consumable | equipment | electric | maintenance | other']
  concept varchar [not null]
  ref_type varchar [note: 'job | empty']
  ref_id varchar
  client_id varchar [ref: > clients.id]
  notes varchar
  archived varchar
  deleted varchar
}

Table tags {
  id varchar [pk]
  name varchar [not null]
  created_at varchar [not null]
  archived varchar
  deleted varchar
}

Table audit_log {
  id varchar [pk, note: 'unique audit entry id']
  timestamp varchar [not null, note: 'ISO 8601 timestamp']
  actor varchar [not null, note: 'user email or "local"']
  entity_name varchar [not null, note: 'client | job | piece | piece_item | inventory | lot | transaction | tag | tag_link | crm_note']
  entity_id varchar [not null, note: 'id of the affected row']
  action varchar [not null, note: 'create | update | delete | archive | unarchive | soft_delete | restore']
  before_json varchar [note: 'full row state before mutation, null for create']
  after_json varchar [note: 'full row state after mutation, null for delete']
  parent_entity_name varchar [note: 'entity type that triggered this cascade, null for root operations']
  parent_entity_id varchar [note: 'entity id that triggered this cascade, null for root operations']
}

Ref: jobs.client_id > clients.id
Ref: pieces.job_id > jobs.id
Ref: piece_items.piece_id > pieces.id
Ref: piece_items.inventory_id > inventory.id
Ref: lots.inventory_id > inventory.id
Ref: lots.transaction_id > transactions.id
Ref: transactions.client_id > clients.id
